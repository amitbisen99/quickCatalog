# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3010
ADMIN_URL=http://localhost:3010/admin
# White-label subdomains are built as `{subdomain}.{APP_BASE_DOMAIN}` — the
# bare domain the frontend is deployed on (no protocol, no path).
APP_BASE_DOMAIN=instantcatalog.app

# ── Database ──────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/quickcatalog

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ── Password hashing ──────────────────────────────────────
BCRYPT_SALT_ROUNDS=10

# ── Brevo (transactional email) ──────────────────────────
# BREVO_SENDER_EMAIL must be a sender (or domain) verified in the Brevo
# dashboard first, or every send gets rejected — see Settings → Senders,
# Domains & Dedicated IPs. Until noreply@instantcatalog.app is verified
# there, use whatever address the account already has verified.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@instantcatalog.app
BREVO_SENDER_NAME=Instant Catalog

# ── Brevo (marketing list sync) ──────────────────────────
# Every vendor is added to this Brevo list (same account/API key as above)
# the moment they verify their email — see services/brevoContacts.service.js.
# Find the ID in Brevo under Contacts → Lists → (your list) — it's shown on
# that page and in the URL. Leave blank to skip the sync entirely (nothing
# else breaks).
BREVO_REGISTRATION_LIST_ID=
# Create these two Contact Attributes in Brevo BEFORE setting the ID above
# (Contacts → Settings → Contact Attributes → Add a new attribute) — Brevo
# can reject the whole sync (not just drop the unknown field) if an
# attribute below isn't already defined there:
#   BUSINESS_NAME   type: Text
#   PLAN             type: Text     (value will be "Free" or "Paid")
# The vendor's phone number is sent as Brevo's own built-in SMS attribute,
# which should already exist on any Brevo account.

# ── DigitalOcean Spaces (image/video/file storage) ───────
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=
DO_SPACES_CDN_URL=

# ── Payments ──────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── AI (catalog file parsing / enhancement) ──────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Super admin (single admin, no team) ──────────────────
ADMIN_EMAIL=
# Base64-encoded bcrypt hash, NOT the raw hash — some hosting panels'
# env-var storage mangles '$' characters, which corrupts a raw bcrypt
# hash (delimited by three of them). Base64 has no '$', so it survives.
# Generate with (run locally, never paste your real password anywhere):
#   node -e "const bcrypt=require('bcryptjs'); bcrypt.hash('YOUR-PASSWORD', 10).then(h => console.log(Buffer.from(h).toString('base64')))"
ADMIN_PASSWORD_HASH=

# ── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
# Requests per window across all /api routes — keyed per logged-in account
# (vendor/admin), or per IP for anonymous traffic (see
# middleware/rateLimiter.js). If this is set in the hosting panel it
# overrides the code default (1000), so keep them in step.
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Shared secret that exempts THIS app's own Next.js server from the rate
# limit above (see utils/internalRequest.js) — the frontend sends it as the
# x-internal-secret header on its server-to-server calls (public catalog
# pages, the domain-resolving middleware, the sitemap), which otherwise all
# land in one IP bucket shared by every visitor of every vendor's catalog.
# Set the SAME value here and as the frontend app's INTERNAL_API_SECRET env
# var (not NEXT_PUBLIC_ — it must never reach the browser). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave blank to disable the exemption (every request is then rate-limited
# by IP/account as normal — safe, just not the fix this enables).
INTERNAL_API_SECRET=

# ── Geolocation (IP → location for analytics) ────────────
GEOLOCATION_API_KEY=
