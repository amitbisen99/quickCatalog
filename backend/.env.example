# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3010
ADMIN_URL=http://localhost:3010/admin

# ── Database ──────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/quickcatalog

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ── Password hashing ──────────────────────────────────────
BCRYPT_SALT_ROUNDS=10

# ── Brevo (transactional email) ──────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@quickcatalog.com
BREVO_SENDER_NAME=QuickCatalog

# ── DigitalOcean Spaces (image/video/file storage) ───────
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=
DO_SPACES_CDN_URL=

# ── Payments ──────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── AI (catalog file parsing / enhancement) ──────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Super admin (single admin, no team) ──────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# ── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ── Geolocation (IP → location for analytics) ────────────
GEOLOCATION_API_KEY=
